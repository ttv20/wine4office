    };

    [contract(Windows.Foundation.UniversalApiContract, 1.0)]
    enum ProtectionPolicyEvaluationResult { Allowed = 0, Blocked = 1, ConsentRequired = 2 };

    [contract(Windows.Foundation.UniversalApiContract, 1.0)]
    enum ProtectionPolicyRequestAccessBehavior { Decrypt = 0, TreatOverridePolicyAsBlock = 1 };

