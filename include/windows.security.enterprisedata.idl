    [contract(Windows.Foundation.UniversalApiContract, 1.0)]
    enum DataProtectionStatus {
        ProtectedToOtherIdentity = 0, Protected = 1, Revoked = 2,
        Unprotected = 3, LicenseExpired = 4, AccessSuspended = 5
    };

    [contract(Windows.Foundation.UniversalApiContract, 1.0)]
    enum EnforcementLevel { NoProtection = 0, Silent = 1, Override = 2, Block = 3 };

    [contract(Windows.Foundation.UniversalApiContract, 1.0)]
