+        This->navpane.quick_items[i] = NULL;
+    }
+    This->navpane.quick_count = 0;
+    if (This->navpane.quick_icons)
+    {
+        ImageList_Destroy(This->navpane.quick_icons);
+        This->navpane.quick_icons = NULL;
+    }
+}
