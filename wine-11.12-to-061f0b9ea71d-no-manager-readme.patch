+        if (SUCCEEDED(SHGetIDListFromObject((IUnknown *)This->navpane.quick_items[i], &pidl)))
+        {
+            if (ILIsEqual(pidl, This->current_pidl))
+                quick_access_set_state(This->navpane.hwnd_quick, i, LVIS_SELECTED | LVIS_FOCUSED,
