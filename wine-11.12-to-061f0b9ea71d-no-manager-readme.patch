+
+    if (RegGetValueW(HKEY_LOCAL_MACHINE, key_name, L"ProductReleaseIds", RRF_RT_REG_SZ,
+            NULL, product_ids, &size) || !wcsstr(product_ids, L"O365ProPlusRetail"))
