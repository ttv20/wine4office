+        *size = sizeof(*state);
+        *value = (BYTE *)state;
+        return S_OK;
+    }
+
+    if (type) *type = SL_DATA_NONE;
+    *size = 0;
+    *value = NULL;
+    return SL_E_VALUE_NOT_FOUND;
 }
 
