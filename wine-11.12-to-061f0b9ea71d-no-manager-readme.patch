+static void clear_last_policy(struct slc_context *context)
+{
+    LocalFree(context->last_name);
+    LocalFree(context->last_value);
+    context->last_name = NULL;
+    context->last_value = NULL;
+    context->last_size = 0;
+    context->last_type = SL_DATA_NONE;
+}
