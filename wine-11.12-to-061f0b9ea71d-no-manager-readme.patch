+    if (!iid_count || !iids) return E_POINTER;
+    if (!(result = CoTaskMemAlloc(3 * sizeof(*result)))) return E_OUTOFMEMORY;
+    result[0] = IID_IHttpBaseProtocolFilter;
+    result[1] = IID_IHttpFilter;
+    result[2] = IID_IClosable;
