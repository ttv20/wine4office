+    if (texture->desc.MiscFlags & (D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX))
+    {
+        if (!texture->shared || !texture->shared->global_resource)
+            return E_FAIL;
+        *handle = ULongToHandle(texture->shared->global_resource);
+        return S_OK;
+    }
+
+    *handle = NULL;
+    return S_OK;
+}
