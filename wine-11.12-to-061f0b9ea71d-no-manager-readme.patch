+
+    xpath_push_value(ctxt, xpath_new_number(ctxt, ret < 0 ? -1.0 : ret > 0 ? 1.0 : 0.0));
+
+done:
+    free(left);
+    free(right);
+    free(language);
+    free(options);
+}
