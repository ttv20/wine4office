+    if (row < 0 || row >= context->height) return;
+    for (i = 0; i < count; i++)
+    {
+        INT first = max( spans[i].x - context->x_min, 0 );
+        INT last = min( spans[i].x + spans[i].len - context->x_min, context->width );
