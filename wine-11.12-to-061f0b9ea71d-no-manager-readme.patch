+    pXRenderComposite( gdi_display, PictOpSrc, src_pict, mask_pict, dst_pict,
+                       0, 0, 0, 0, dst_x, dst_y, dst_width, dst_height );
+    pXRenderFreePicture( gdi_display, dst_pict );
+    pXRenderFreePicture( gdi_display, src_pict );
+    free( clip_data );
+    return TRUE;
+#else
+    return FALSE;
+#endif
