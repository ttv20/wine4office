MODULE = winewayland-host.exe
UNIXLIB = winewayland-host.so
IMPORTS = user32 ntdll
UNIX_CFLAGS = $(WAYLAND_CLIENT_CFLAGS) $(XKBCOMMON_CFLAGS)
UNIX_LIBS = $(WAYLAND_CLIENT_LIBS) $(XKBCOMMON_LIBS) $(PTHREAD_LIBS)

EXTRADLLFLAGS = -mconsole -municode

SOURCES = \
	fractional-scale-v1.xml \
	main.c \
	unixlib.c \
	viewporter.xml \
	xdg-shell.xml
