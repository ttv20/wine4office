#!/usr/bin/env python3
"""Forward only the Office broker callback to a matching native sign-in session.

No callback URL, authorization code, or response text is logged or saved.
The native helper checks unpredictable OAuth state and uses its original PKCE
verifier. Receiving a URL alone cannot create a signed-in account.
"""
import argparse
import os
from pathlib import Path
import subprocess
import sys
from urllib.parse import parse_qs, urlsplit


def valid_callback(uri):
    if len(uri) > 16384 or any(ord(c) < 32 or ord(c) == 127 for c in uri):
        return False
    try:
        value = urlsplit(uri)
        if (value.scheme.lower() != 'ms-appx-web'
                or value.netloc.lower() != 'microsoft.aad.brokerplugin'
                or value.path.lower() != '/d3590ed6-52b3-4102-aeff-aad2292ab01c'
                or value.fragment):
            return False
        fields = parse_qs(value.query, keep_blank_values=True, max_num_fields=20)
        if len(fields.get('state', [])) != 1 or not fields['state'][0]:
            return False
        return ((len(fields.get('code', [])) == 1 and bool(fields['code'][0]) and 'error' not in fields)
                or (len(fields.get('error', [])) == 1 and bool(fields['error'][0]) and 'code' not in fields))
    except (ValueError, UnicodeError):
        return False


class QuietParser(argparse.ArgumentParser):
    def error(self, message):
        # argparse's usual message can include an unrecognized callback argument.
        raise ValueError("Invalid sign-in return arguments")


def main(argv=None):
    parser = QuietParser(description=__doc__)
    parser.add_argument('--wine', required=True, help='Absolute path to the Wine4Office runner')
    parser.add_argument('--prefix', required=True, help='Existing Office Wine prefix')
    parser.add_argument('uri', help='Browser callback (do not paste into a terminal or log)')
    try:
        args = parser.parse_args(argv)
        if not valid_callback(args.uri):
            return 2
        wine = Path(args.wine)
        prefix = Path(args.prefix)
        if (not wine.is_absolute() or not wine.is_file() or not os.access(wine, os.X_OK)
                or not prefix.is_absolute() or not (prefix / 'drive_c/windows').is_dir()):
            return 2
        env = os.environ.copy()
        env.update(WINEPREFIX=str(prefix), WINEDEBUG='-all')
        result = subprocess.run(
            [str(wine), r'C:\windows\system32\wine4officeauth.exe', '--browser-callback', args.uri],
            env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL, timeout=20)
        return result.returncode
    except ValueError:
        return 2
    except (OSError, subprocess.TimeoutExpired):
        # Exception text and argv can contain the private callback.
        return 3


if __name__ == '__main__':
    sys.exit(main())
